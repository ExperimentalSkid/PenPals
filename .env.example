NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=

# Production only: load into the deployment job, not the browser or .env.local.
# Consumed by the self-hosted Supabase Auth Compose override; setting them only
# in the Next.js process does not reconfigure a running Auth container.
SUPABASE_AUTH_CONFIRM_REDIRECT_URL=
SUPABASE_AUTH_URI_ALLOW_LIST=
SUPABASE_AUTH_SMTP_HOST=smtp.resend.com
SUPABASE_AUTH_SMTP_PORT=465
SUPABASE_AUTH_SMTP_USER=resend
# Server-only Resend sending key. Never commit the populated value.
RESEND_API_KEY=
SUPABASE_AUTH_SMTP_ADMIN_EMAIL=no-reply@pen-pals.net
SUPABASE_AUTH_SMTP_SENDER_NAME=Pen-Pals

# Server-only: required by account-management operations and `pnpm jobs:run`.
# Also used by configured verification services; never expose in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only HMAC key for binding an authenticated Settings → Connect Google
# linking attempt. Generate a random value of at least 32 characters.
GOOGLE_LOGIN_STATE_SECRET=

# Optional Supabase Auth Google provider credentials for local/self-hosted Auth.
# Keep the provider disabled until these are configured in the Auth dashboard or
# secret manager; these are unrelated to Google profile verification credentials.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Optional external-account verification (server-only; never expose in NEXT_PUBLIC_ variables).
# Provider policies remain disabled until explicitly configured by an administrator.
VERIFICATION_STATE_SECRET=
VERIFICATION_SUBJECT_HMAC_SECRET=
GOOGLE_VERIFICATION_CLIENT_ID=
GOOGLE_VERIFICATION_CLIENT_SECRET=
FACEBOOK_VERIFICATION_CLIENT_ID=
FACEBOOK_VERIFICATION_CLIENT_SECRET=
INSTAGRAM_VERIFICATION_CLIENT_ID=
INSTAGRAM_VERIFICATION_CLIENT_SECRET=
TIKTOK_VERIFICATION_CLIENT_KEY=
TIKTOK_VERIFICATION_CLIENT_SECRET=
