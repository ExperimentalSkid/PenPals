# Copy these email settings into the private VPS deployment environment.
# Load this file alongside the existing Supabase Docker environment, never instead of it.
# Keep the populated copy outside the repository. The Resend API key is server-only.

# Absolute Linux path to the deployed Pen-Pals repository checkout; adjust to your VPS.
# Its supabase/templates/production directory must already contain all six HTML files.
PENPALS_REPOSITORY_PATH=/srv/penpals

# Canonical application origin, also used by the deployed Next.js app.
NEXT_PUBLIC_SITE_URL=https://pen-pals.net

# Public HTTPS origin of the self-hosted Supabase API gateway. Set this before
# validation; it is intentionally blank because the VPS/reverse-proxy host is not known here.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_AUTH_CONFIRM_REDIRECT_URL=https://pen-pals.net/auth/confirm

# Full comma-separated Auth redirect allow-list. Keep any existing required exact
# production destinations when combining this example with the current VPS setting.
SUPABASE_AUTH_URI_ALLOW_LIST=https://pen-pals.net/auth/confirm,https://pen-pals.net/auth/callback,https://pen-pals.net/auth/callback?mode=login,https://pen-pals.net/auth/callback?mode=link

# The overlay fixes the Resend SMTP host to smtp.resend.com and username to resend.
# Use a supported TLS port: 465 (implicit TLS), or 587 (STARTTLS).
SUPABASE_AUTH_SMTP_PORT=465
SUPABASE_AUTH_SMTP_HOST=smtp.resend.com
SUPABASE_AUTH_SMTP_USER=resend

# The sender must belong to the domain verified in your Resend account.
SUPABASE_AUTH_SMTP_ADMIN_EMAIL=no-reply@pen-pals.net
SUPABASE_AUTH_SMTP_SENDER_NAME=Pen-Pals

# Set the sending API key only in the private VPS environment or secret manager.
RESEND_API_KEY=

# Also set these on the deployed Next.js server if you want staff replies from
# /app/admin/contact to send through Resend. They are ignored by Supabase Auth.
SUPPORT_EMAIL_FROM="Pen-Pals <no-reply@pen-pals.net>"
SUPPORT_EMAIL_REPLY_TO=

# Retain API_EXTERNAL_URL and SUPABASE_PUBLIC_URL from the existing Supabase stack.
# This example does not set or infer the externally reachable Supabase API address.
