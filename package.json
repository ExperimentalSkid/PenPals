{
  "name": "penpal",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check:production-email": "node scripts/validate-production-email-config.mjs",
    "jobs:run": "node scripts/run-background-jobs.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "schema:lint": "node scripts/schema-lint.mjs",
    "schema:check": "node scripts/check-migrations.mjs",
    "schema:check:local": "node scripts/check-migrations.mjs --local",
    "schema:verify": "pnpm schema:check:local && pnpm schema:lint"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
